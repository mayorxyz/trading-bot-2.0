# Bybit API Credentials (TESTNET)
# Get these from: https://testnet.bybit.com/app/api-keys

BYBIT_API_KEY=your_testnet_api_key_here
BYBIT_API_SECRET=your_testnet_api_secret_here
BYBIT_TESTNET=true

# Trading Configuration
DEFAULT_LEVERAGE=10
ACCOUNT_RISK_PCT=0.01
MAX_CONCURRENT_POSITIONS=4
MAX_PORTFOLIO_HEAT=0.06

# Symbols to Trade (comma-separated)
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Timeframes
HTF_TIMEFRAME=4h
LTF_TIMEFRAME=15m

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_LEVEL=WARNING

# Logging
LOG_LEVEL=INFO

# Risk Management
DAILY_DD_LIMIT=-0.03
CONSECUTIVE_LOSS_LIMIT=8
PORTFOLIO_DD_LIMIT=-0.15
SLIPPAGE_THRESHOLD=0.30

# Signal Thresholds
MIN_CONFLUENCE_SCORE=0.6
MIN_RISK_REWARD=1.5
FRESH_FVG_MAX_AGE_BARS_1H=72
FRESH_FVG_MAX_AGE_BARS_15M=48
MAX_OB_TOUCHES=3

# Performance Monitoring
METRICS_ROLLING_WINDOW=100
SHARPE_WINDOW_DAYS=60
CORRELATION_WINDOW_DAYS=90

# Macro Event Gate (minutes)
MACRO_EVENT_BLACKOUT_MIN_BEFORE=30
MACRO_EVENT_BLACKOUT_MIN_AFTER=10

# API Rate Limits
API_ERROR_RATE_LIMIT=0.03
FILL_RATE_MIN=0.80

# === EXECUTION MODE ===
# Set to 'true' for automated trading (bot places orders automatically)
# Set to 'false' for signals-only mode (bot sends alerts, user manually executes)
AUTO_EXECUTE=false
